# Runtime artifacts — never commit these
logs/
reports/
feedback/

# Editor / OS swap files
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Backup files generated by --uninstall-alias (sed -i.bak)
*.bak

# Local-only overrides
.env
.env.local
config.local.sh

# npm
node_modules/
npm-debug.log*
*.tgz
.npmrc

# The desktop app is private (aoneahsan/linux-cleanup-desktop); never in this public repo
/desktop/

# Yarn 4 (Berry) — ignore cache/state, allow patches/plugins/releases/sdks/versions
**/.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
