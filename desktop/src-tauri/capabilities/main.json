{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window, 'main'. Grants exactly what the UI calls: the app's own commands, update check and relaunch, notifications, and opening https links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-cli-info",
    "allow-run-cli",
    "allow-cancel-run",
    "allow-system-info",
    "allow-disk-status",
    "allow-export-json",
    "allow-set-tray-mode",
    "allow-list-local-history",
    "allow-open-path",
    "allow-reveal-path",
    "allow-oauth-listen",
    "allow-schedule-list",
    "allow-schedule-install",
    "allow-schedule-remove",
    "allow-list-schedule-runs",
    "allow-read-schedule-run",
    "allow-ack-schedule-run",
    "updater:default",
    "process:allow-restart",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
