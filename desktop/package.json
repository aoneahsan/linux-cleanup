{
  "name": "linux-cleanup-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --logLevel info",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "i18n:check": "eslint -c eslint.i18n.config.js src --max-warnings 0",
    "gates": "yarn typecheck && yarn lint && yarn test && yarn i18n:check && yarn build",
    "tauri": "tauri",
    "deps:check": "npx -y npm-check-updates",
    "deps:update": "npx -y npm-check-updates -u && yarn",
    "db:generate": "cd supabase && drizzle-kit generate"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.48.1",
    "@hookform/resolvers": "^6.0.2",
    "@internationalized/date": "^3.12.4",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "d3-scale": "^4.0.2",
    "driver.js": "^1.10.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "strata-storage": "^3.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@polar-sh/sdk": "1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "~0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
